{
  "name": "rust-echo-music",
  "version": "0.1.0",
  "description": "A desktop music player built with SvelteKit and Tauri",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "plugins:build": "node scripts/build-packaged-plugins.mjs",
    "plugins:build:release": "node scripts/build-packaged-plugins.mjs --release",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@mdui/icons": "^1.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-virtual": "^3.13.36",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-store": "^2.4.4",
    "mdui": "^2.1.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "packageManager": "pnpm@12.3.4"
}
